{
  "name": "fspy-ue",
  "version": "0.2.0",
  "packageManager": "yarn@1.22.22",
  "main": "build/main.js",
  "homepage": "https://github.com/EnneiteG/fSpy-UE",
  "repository": {
    "type": "git",
    "url": "https://github.com/EnneiteG/fSpy-UE.git"
  },
  "author": {
    "name": "Per Gantelius",
    "email": "per@stuffmatic.com",
    "url": "https://stuffmatic.com"
  },
  "description": "An open source, cross platform app for still image camera matching",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=16 <25"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.5",
    "@babel/preset-react": "7.28.5",
    "@types/electron-window-state": "2.0.34",
    "@types/jest": "23.3.14",
    "@types/minimatch": "3.0.5",
    "@types/minimist": "1.2.5",
    "@types/node": "10.17.60",
    "@types/react": "16.14.69",
    "@types/react-dom": "16.9.25",
    "@types/react-measure": "2.0.12",
    "@types/react-redux": "7.1.34",
    "@types/yargs": "12.0.20",
    "babel-loader": "9.2.1",
    "cross-env": "7.0.3",
    "css-loader": "6.11.0",
    "electron": "22.3.27",
    "electron-builder": "26.8.1",
    "html-webpack-plugin": "5.6.0",
    "jest": "23.6.0",
    "jest-junit": "5.2.0",
    "standard": "11.0.1",
    "style-loader": "3.3.4",
    "trash-cli": "1.4.0",
    "ts-loader": "9.5.4",
    "tslint": "5.20.1",
    "tslint-config-standard": "7.1.0",
    "tslint-loader": "3.6.0",
    "typescript": "4.9.5",
    "webpack": "5.106.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.2"
  },
  "scripts": {
    "prebuild-dev": "trash build",
    "build-dev": "node scripts/run-webpack-tool.js webpack --config webpack.config.js --mode development",
    "prebuild-dist": "trash build",
    "build-dist": "node scripts/run-webpack-tool.js webpack --config webpack.config.js --mode production",
    "predist": "npm run build-dist",
    "predist-preview": "npm run build-dist",
    "predist-win": "trash dist && npm run build-dist",
    "dist-preview": "electron-builder --dir",
    "dist-win": "electron-builder --win --x64 --publish never",
    "prebuild-test": "trash __tests__",
    "build-test": "node scripts/run-webpack-tool.js webpack --config webpack.tests.config.js --mode development",
    "pretest": "npm run build-test",
    "dev-server": "node scripts/run-webpack-tool.js webpack serve --config webpack.config.js --mode development",
    "electron-dev": "cross-env DEV=true node scripts/run-electron.js .",
    "dist": "electron-builder -mwl",
    "test": "jest",
    "verify": "npm run build-dev && npm test",
    "prepublish-release": "npm run build-dist",
    "publish-release": "electron-builder -mwl --publish always"
  },
  "dependencies": {
    "electron-window-state": "4.1.1",
    "konva": "2.1.3",
    "minimist": "1.2.8",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "react-konva": "1.7.16",
    "react-measure": "2.5.2",
    "react-redux": "7.2.9",
    "redux": "4.2.1",
    "redux-thunk": "2.4.2"
  },
  "resolutions": {
    "electron": "22.3.27",
    "@types/react": "16.14.69",
    "redux": "4.2.1"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "EnneiteG",
      "repo": "fSpy-UE",
      "publishAutoUpdate": false
    },
    "productName": "fSpy UE",
    "appId": "com.enneiteg.fspyue",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "files": [
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/electron",
        "to": "",
        "filter": [
          "example.fspy"
        ]
      },
      {
        "from": "assets/build",
        "to": "",
        "filter": [
          "icon.ico"
        ]
      },
      {
        "from": "assets/electron",
        "to": "",
        "filter": [
          "icon.png"
        ]
      },
      {
        "from": "assets/electron",
        "to": "",
        "filter": [
          "icon.svg"
        ]
      }
    ],
    "directories": {
      "buildResources": "assets/build"
    },
    "fileAssociations": [
      {
        "ext": "fspy",
        "name": "fSpy project",
        "description": "fSpy project file",
        "role": "Editor"
      }
    ]
  },
  "jest": {
    "testRegex": "/__tests__/.*\\.jsx?",
    "transform": {},
    "testResultsProcessor": "jest-junit"
  },
  "jest-junit": {
    "suiteName": "jest tests",
    "output": "./TEST-jest_junit.xml",
    "classNameTemplate": "{classname}-{title}",
    "titleTemplate": "{classname}-{title}",
    "usePathForSuiteName": "true"
  }
}
